# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# If these are left unset, the app falls back to a local-only mode backed by
# localStorage instead of Supabase — useful for a quick demo with no setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
